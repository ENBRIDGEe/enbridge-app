# ============================================================
# ENBRIDGE APP — Environment Variables Template
# ============================================================
# Copy this file to `.env` and fill in the real values.
# Get credentials from the team lead.
# ============================================================

# --- Supabase ---
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here

# --- Test Account (for team dev/testing only) ---
TEST_EMAIL=your-test@email.com
TEST_PASSWORD=your-testing-password-here

# --- AI Integration Keys ---
# Production mobile builds should call the Supabase edge function instead of
# shipping model keys in the client.
# NVIDIA_API_KEY=optional-local-dev-fallback-only

# Optional local web fallback:
# If the Supabase `aiva-chat` edge function is not deployed yet, run
# `node scripts/aiva_local_proxy.mjs` during local web development.
