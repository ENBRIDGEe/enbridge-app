{
  // VS Code launch config for Enbridge Flutter app.
  // Loads all secrets from .env.json via --dart-define-from-file (never committed).
  // Copy .env.example → .env.json and fill in values before running.
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Enbridge (Dev)",
      "request": "launch",
      "type": "dart",
      "program": "lib/main.dart",
      "args": [
        "--dart-define-from-file=.env.json"
      ]
    },
    {
      "name": "Enbridge (Release)",
      "request": "launch",
      "type": "dart",
      "program": "lib/main.dart",
      "flutterMode": "release",
      "args": [
        "--dart-define-from-file=.env.json"
      ]
    }
  ]
}
